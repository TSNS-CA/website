# ── Square (server-side, used by Cloudflare functions at runtime) ──
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_ENV=sandbox                      # sandbox | production
SQUARE_YEARLY_PLAN_ID=                  # Square Subscription plan id (yearly cadence)

# ── Square (client-side, baked into the build — set BEFORE build) ──
VITE_SQUARE_APPLICATION_ID=your_square_application_id_here
VITE_SQUARE_LOCATION_ID=your_square_location_id_here
VITE_SQUARE_ENV=sandbox                 # sandbox | production

# ── Supabase (server-side; service_role bypasses RLS — keep secret) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Student discount coupons (comma-separated; yearly membership -> $5) ──
# Use a long, random code — a guessable one is found in a few tries.
STUDENT_COUPON_CODES=ogr-change-me-7f3k9q2m

# ── Cloudflare Turnstile (bot protection, docs/SETUP.md §4.4) ──
# Set BOTH or NEITHER. Secret without the site key = every form returns 403.
TURNSTILE_SECRET_KEY=                   # runtime, Secret
VITE_TURNSTILE_SITE_KEY=                # build-time

# ── Resend (membership / donation / volunteer emails) ──
RESEND_API_KEY=re_xxxxxxxx

# Confirmations go out as Resend-hosted templates. The template owns its
# from-address, subject and design; we only pass variables. Both templates are
# bilingual (TR + EN in one email), so there is one id each.
RESEND_MEMBERSHIP_TEMPLATE_ID=          # "membership-confirmation" — yearly membership + one-time donation
RESEND_VOLUNTEER_TEMPLATE_ID=           # "volunteer-confirmation"

# Used for the internal notices, and as a fallback if a template id is missing.
# The domain must be verified in Resend (see docs/SETUP.md).
RESEND_FROM=Nova Scotia Türk Derneği <info@tsns.ca>
RESEND_REPLY_TO=info@tsns.ca            # optional; where replies land
RESEND_ADMIN_TO=info@tsns.ca            # optional, comma-separated; internal "new signup" notices
